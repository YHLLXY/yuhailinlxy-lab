---
interface Props {
  milestone: string;
  items: string[];
}

const { milestone, items } = Astro.props;
---
<div class="lab-container pb-16">
  <div class="rounded-card border border-dashed border-border-strong bg-surface-sunken p-6 md:p-7">
    <p class="lab-eyebrow mb-3">建设中 · {milestone}</p>
    <p class="text-sm text-muted-foreground">这一页的内容还没接入，落地后会包含：</p>
    <ul class="mt-4 space-y-2 text-sm text-foreground">
      {items.map((item) => (
        <li class="flex gap-2.5">
          <span class="mt-2 size-1 shrink-0 rounded-full bg-accent"></span>
          <span class="text-muted-foreground">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
