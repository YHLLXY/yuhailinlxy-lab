---
// 图标为自绘（20×20 网格），不引用任何图标库或字体
---
<button
  type="button"
  data-theme-toggle
  class="lab-icon-btn shrink-0"
  aria-label="切换到深色模式"
  aria-pressed="false"
>
  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="size-[18px]">
    <g class="lab-icon-sun" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <circle cx="10" cy="10" r="3.5"></circle>
      <path d="M10 2.3v1.8M10 15.9v1.8M2.3 10h1.8M15.9 10h1.8"></path>
      <path d="M4.6 4.6l1.3 1.3M14.1 14.1l1.3 1.3M15.4 4.6l-1.3 1.3M5.9 14.1l-1.3 1.3"></path>
    </g>
    <path
      class="lab-icon-moon"
      d="M16.2 12.4A7.1 7.1 0 0 1 7.6 3.8a7.1 7.1 0 1 0 8.6 8.6Z"
      fill="currentColor"></path>
  </svg>
</button>
