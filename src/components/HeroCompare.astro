---
// 首页的核心演示：两条曲线同帧跑一次。
// 固定为 out-expo 与 in-expo —— 它们互为镜像，对照最直观。
const CURVES = [
  { label: 'out-expo', bezier: '0.16, 1, 0.3, 1', dot: 'bg-curve-a', line: 'var(--lab-curve-a)', d: 'M0 240 C 77 0 144 0 480 0' },
  { label: 'in-expo', bezier: '0.7, 0, 0.84, 0', dot: 'bg-curve-b', line: 'var(--lab-curve-b)', d: 'M0 240 C 336 240 403 240 480 0' },
] as const;
const DURATION = 320;
---
<div class="overflow-hidden rounded-card border border-border bg-surface-sunken p-4 md:p-6">
  <div class="text-foreground">
    <svg
      viewBox="0 0 480 240"
      class="mx-auto block h-auto w-full max-w-[540px]"
      role="img"
      aria-label="两条缓动曲线对照：out-expo 先快后慢，in-expo 先慢后快"
    >
      <defs>
        <pattern id="lab-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-opacity="0.07" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="480" height="240" fill="url(#lab-grid)"></rect>
      <line x1="0" y1="239" x2="480" y2="239" stroke="currentColor" stroke-opacity="0.22" stroke-width="1"></line>
      {CURVES.map((c) => (
        <path d={c.d} fill="none" stroke={c.line} stroke-width="2.5" stroke-linecap="round"></path>
      ))}
    </svg>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
      {CURVES.map((c) => (
        <span class="inline-flex items-center gap-2 text-muted-foreground">
          <span class={`h-0.5 w-4 rounded-full ${c.dot}`}></span>
          <span class="tnum text-foreground">{c.label}</span>
          <span class="tnum">{c.bezier}</span>
        </span>
      ))}
    </div>
    <button type="button" class="hero-play" data-hero-play>同帧播放</button>
  </div>

  <div class="mt-3 space-y-2" data-hero-tracks>
    {CURVES.map((c) => (
      <div class="relative h-6 rounded bg-surface" data-hero-track data-easing={`cubic-bezier(${c.bezier})`}>
        <span class="absolute inset-x-2 top-1/2 h-px -translate-y-1/2 bg-border-strong" aria-hidden="true"></span>
        <span class={`absolute top-[calc(50%-5px)] left-2 size-2.5 rounded-full ${c.dot}`} data-hero-dot></span>
      </div>
    ))}
  </div>

  <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
    同样跑 {DURATION}ms，一条像「弹出来」，一条像「被挤出来」。手感只在并排对照时才看得清 ——
    其余 18 条曲线在<a href="/easing" class="text-accent underline-offset-2 hover:underline">缓动曲线</a>。
  </p>
</div>

<style>
  .hero-play {
    border-radius: 9999px;
    border: 1px solid var(--lab-accent);
    padding: 0.35rem 0.8rem;
    font-size: 12px;
    line-height: 1.4;
    background-color: var(--lab-accent);
    color: var(--lab-accent-foreground);
    transition: filter var(--lab-dur-fast) var(--lab-ease-out);
  }

  .hero-play:hover {
    filter: brightness(1.06);
  }
</style>

<script>
  const root = document.querySelector('[data-hero-tracks]');
  const btn = document.querySelector<HTMLButtonElement>('[data-hero-play]');
  const DURATION = 320;

  btn?.addEventListener('click', () => {
    if (!root) return;
    const tracks = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-track]'));
    const dots = tracks.map((t) => t.querySelector<HTMLElement>('[data-hero-dot]')).filter(Boolean) as HTMLElement[];

    // 归零后强制回流，否则会从上一次的终点开始
    dots.forEach((d) => {
      d.style.transition = 'none';
      d.style.transform = 'translateX(0px)';
    });
    void root.offsetWidth;

    // 同一个任务内写入两条过渡 —— 同帧起跑
    dots.forEach((d, i) => {
      const track = d.closest<HTMLElement>('[data-hero-track]');
      const easing = track?.dataset.easing ?? 'linear';
      const dist = Math.max(0, (track?.clientWidth ?? 0) - 16 - d.offsetWidth);
      d.style.transition = `transform ${DURATION}ms ${easing}`;
      d.style.transform = `translateX(${dist}px)`;
    });
  });
</script>
