---
import type { TimingScenario } from '../data/timing';

interface Props {
  scenario: TimingScenario;
}

const { scenario } = Astro.props;

const variants = [
  { key: 'fast', label: '过快', ms: scenario.fast, fill: 'bg-curve-b' },
  { key: 'base', label: '基准', ms: scenario.base, fill: 'bg-curve-a' },
  { key: 'slow', label: '过慢', ms: scenario.slow, fill: 'bg-muted-foreground' },
];
---
<li class="border-b border-border py-5" data-timing-row data-easing={scenario.easing}>
  <div class="grid items-start gap-x-4 gap-y-2 md:grid-cols-[minmax(0,1fr)_6rem_9rem_auto] md:items-center">
    <div class="min-w-0">
      <h3 class="text-sm font-medium text-foreground">{scenario.name}</h3>
      <p class="mt-1 text-xs leading-relaxed text-muted-foreground">{scenario.why}</p>
    </div>
    <div class="tnum text-sm text-foreground">{scenario.range}</div>
    <div class="text-xs text-muted-foreground">{scenario.easingName}</div>
    <button
      type="button"
      class="timing-try justify-self-start md:justify-self-end"
      data-try
      aria-expanded="false"
      aria-controls={`demo-${scenario.id}`}
    >
      试一下
    </button>
  </div>

  <div
    id={`demo-${scenario.id}`}
    class="mt-4 rounded-md border border-border bg-surface-sunken p-3"
    data-demo
    hidden
  >
    <div class="space-y-2.5">
      {variants.map((v) => (
        <div class="flex items-center gap-3">
          <span class="w-8 shrink-0 text-[11px] text-muted-foreground">{v.label}</span>
          <div class="relative h-4 flex-1 overflow-hidden rounded-full bg-muted">
            <span
              class={`absolute inset-y-0 left-0 w-full origin-left rounded-full ${v.fill}`}
              data-fill
              data-ms={v.ms}></span>
          </div>
          <span class="tnum w-14 shrink-0 text-right text-[11px] text-muted-foreground">{v.ms}ms</span>
        </div>
      ))}
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
      <button type="button" class="timing-try" data-replay>重播</button>
      <p class="text-[11px] leading-relaxed text-muted-foreground">
        三条同帧起跑，只有时长不同。Material 3 对应档位：{scenario.material}
      </p>
    </div>
  </div>
</li>

<style>
  .timing-try {
    border-radius: 9999px;
    border: 1px solid var(--lab-border-strong);
    padding: 0.3rem 0.7rem;
    font-size: 12px;
    line-height: 1.4;
    color: var(--lab-foreground);
    transition: background-color var(--lab-dur-fast) var(--lab-ease-out);
  }

  .timing-try:hover {
    background-color: var(--lab-muted);
  }

  .timing-try[aria-expanded='true'] {
    border-color: var(--lab-accent);
    color: var(--lab-accent);
  }

  [data-fill] {
    transform: scaleX(0);
    will-change: transform;
  }
</style>
