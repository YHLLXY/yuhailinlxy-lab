---
import Base from '../layouts/Base.astro';
import HeroCompare from '../components/HeroCompare.astro';

const entries = [
  {
    href: '/easing',
    count: '18',
    unit: '条',
    title: '缓动曲线',
    desc: '进场 7 · 退场 4 · 位移 7。每条都写清用在哪、以及什么时候别用。',
  },
  {
    href: '/timing',
    count: '11',
    unit: '个场景',
    title: '时长节奏',
    desc: '从 hover 的 120ms 到页面转场的 480ms。按场景给数，不给「200~500ms」这种废话区间。',
  },
  {
    href: '/rules',
    count: '5',
    unit: '条',
    title: '原则',
    desc: '五条铁律，外加一整页「这里不该动」的清单 —— 比该动的时候更难判断。',
  },
];
---
<Base title="动效实验室">
  <section class="lab-container pt-14 md:pt-24">
    <p class="lab-eyebrow mb-5">动效实验室 · Motion Lab</p>
    <h1 class="lab-display max-w-3xl">
      动效不是装饰，<br class="sm:hidden" />是一个决策。
    </h1>
    <p class="lab-lead mt-6 max-w-2xl">
      同一个按钮，180ms 还是 320ms，ease-out 还是 ease-in-out —— 用户说不上来，但感觉得到。
      这个站点把「说不上来」的部分，拆成可以对照、可以量化的东西。
    </p>
    <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1.5 text-xs text-muted-foreground">
      <span class="size-1.5 rounded-full bg-curve-a"></span>
      所有演示都由你触发，这个网站自己不动。
    </p>
  </section>

  <section class="lab-container mt-12 md:mt-16" aria-labelledby="pair-title">
    <h2 id="pair-title" class="sr-only">双曲线对照</h2>
    <HeroCompare />
  </section>

  <section class="lab-container mt-12 md:mt-16" aria-labelledby="entries-title">
    <h2 id="entries-title" class="sr-only">内容入口</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {entries.map((e) => (
        <a href={e.href} class="lab-card group p-5 md:p-6">
          <div class="flex items-baseline gap-1.5">
            <span class="tnum text-2xl leading-none font-semibold text-foreground">{e.count}</span>
            <span class="text-xs text-muted-foreground">{e.unit}</span>
          </div>
          <h3 class="mt-7 text-[0.9375rem] font-semibold text-foreground">{e.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{e.desc}</p>
          <span
            class="mt-5 inline-flex items-center gap-1 text-xs text-accent transition-transform duration-200 group-hover:translate-x-0.5"
          >
            看看 <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="lab-container mt-16 md:mt-24">
    <div class="max-w-2xl border-l-2 border-curve-a pl-5">
      <p class="text-sm leading-relaxed text-muted-foreground">
        <span class="font-semibold text-foreground">为什么不直接抄 easings.net。</span>
        easings.net 给你曲线，cubic-bezier.com 给你调参，Animista 给你现成代码 ——
        它们都不回答一个问题：<span class="text-foreground">这里到底该不该动。</span>
      </p>
    </div>
  </section>
</Base>
