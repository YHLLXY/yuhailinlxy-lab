---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EasingCard from '../components/EasingCard.astro';
import ComparePanel from '../components/ComparePanel.astro';
import { EASINGS_BY_CATEGORY, EASINGS } from '../data/easings';
---
<Base
  title="缓动曲线"
  description="18 条常用缓动曲线的性格对照：进场 7 条、退场 4 条、位移 7 条，每条标注适用场景、禁用场景与建议时长。"
>
  <PageHeader
    eyebrow="Easing · 18 条"
    title="18 条曲线，18 种性格"
    lead="曲线本身没人记得住，记得住的是「这个看起来急」。所以这里不讲数学，讲它给人的感觉、适合放在哪儿、以及放在哪儿会出问题。"
  />

  <div class="lab-container">
    <div class="rounded-card border border-border bg-surface p-4 text-xs leading-relaxed text-muted-foreground sm:p-5">
      <p>
        每张卡片里那条<strong class="text-foreground">虚线对角线</strong>是匀速参照系 ——
        曲线偏离它多少，就是这条缓动的「性格」有多少。点「播放」看它真实跑一遍。
      </p>
      <p class="mt-2">
        顺序按用途分三组（<span class="tnum">{EASINGS.length}</span> 条 =
        进场 {EASINGS_BY_CATEGORY[0].items.length} · 退场 {EASINGS_BY_CATEGORY[1].items.length} · 位移 {EASINGS_BY_CATEGORY[2].items.length}），
        不是按 cubic-bezier 数值排 —— 你要找的是「这种场合该用什么」，不是「0.16 在哪一页」。
      </p>
    </div>
  </div>

  <ComparePanel />

  {EASINGS_BY_CATEGORY.map((group) => (
    <section class="lab-container mt-12 md:mt-16" aria-labelledby={`group-${group.category}`}>
      <div class="mb-5 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-border pb-3">
        <h2 id={`group-${group.category}`} class="text-base font-semibold text-foreground">
          {group.label}
        </h2>
        <span class="tnum text-xs text-muted-foreground">{group.items.length} 条</span>
        <p class="w-full text-xs text-muted-foreground sm:w-auto sm:flex-1">{group.hint}</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
        {group.items.map((curve) => <EasingCard curve={curve} />)}
      </div>
    </section>
  ))}

  <p class="lab-container mt-14 text-xs text-muted-foreground">
    数据与文案说明：曲线名称与 cubic-bezier 数值属数学事实；「用在哪 / 别用在哪 / 时长」为本站编辑判断，
    可讨论、可推翻。未引入任何第三方动画库。
  </p>
</Base>

<script>
  const REDUCED = () => document.documentElement.getAttribute('data-motion') === 'reduce';

  /** 复制文本：优先 Clipboard API，失败回退到临时 textarea */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch {
        return false;
      }
    }
  }

  function flash(btn: HTMLButtonElement, label: string) {
    const original = btn.dataset.label ?? btn.textContent ?? '';
    btn.dataset.label = original;
    btn.textContent = label;
    btn.dataset.done = 'true';
    window.setTimeout(() => {
      btn.textContent = original;
      btn.dataset.done = 'false';
    }, 1200);
  }

  for (const card of document.querySelectorAll<HTMLElement>('[data-easing-card]')) {
    const track = card.querySelector<HTMLElement>('[data-track]');
    const dot = card.querySelector<HTMLElement>('[data-dot]');
    const easing = card.dataset.easing ?? 'ease';
    const duration = Number(card.dataset.duration ?? 300);
    let running: Animation | null = null;

    card.querySelector<HTMLButtonElement>('[data-play]')?.addEventListener('click', () => {
      if (!track || !dot) return;
      // 圆点左内边距 8px、右侧同样留 8px
      const distance = Math.max(0, track.clientWidth - 16 - dot.offsetWidth);

      running?.cancel();

      // 用户要求减少动效时，直接呈现终点状态，而不是什么都不发生
      if (REDUCED()) {
        dot.style.transform = `translateX(${distance}px)`;
        return;
      }

      dot.style.transform = 'translateX(0)';
      running = dot.animate(
        [{ transform: 'translateX(0px)' }, { transform: `translateX(${distance}px)` }],
        { duration, easing, fill: 'both' },
      );
    });

    card.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (event) => {
      const btn = event.currentTarget as HTMLButtonElement;
      const ok = await copyText(easing);
      flash(btn, ok ? '已复制' : '复制失败');
    });
  }
</script>

<script>
  // ─────────────────────────────────────────────────────────────
  // 对照台：选两条曲线，让它们在同一帧起跑。
  //
  // 为什么用 CSS transition 而不是 WAAPI：两条 transition 只要在
  // 同一个任务里被写入，浏览器就只在同一次样式重算中提交，
  // 起点必然落在同一帧；不必手动同步 startTime。
  // 另外，全局的 [data-motion="reduce"] 规则会把 transition-duration
  // 压到 0.001ms，减少动效时自动变成「瞬间到位」，无需额外分支。
  // ─────────────────────────────────────────────────────────────

  const panel = document.querySelector<HTMLElement>('[data-compare]');

  if (panel) {
    const chart = panel.querySelector<SVGSVGElement>('[data-compare-chart]');
    const controls = panel.querySelector<HTMLElement>('[data-compare-controls]');
    const hint = panel.querySelector<HTMLElement>('[data-compare-hint]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-easing-card]'));
    const picked: HTMLElement[] = [];

    const slotOf = (k: 'a' | 'b') => panel.querySelector<HTMLElement>(`[data-slot="${k}"]`);
    const dotOf = (k: 'a' | 'b') => panel.querySelector<HTMLElement>(`[data-dot="${k}"]`);

    const bezierOf = (card: HTMLElement): number[] => {
      const m = (card.dataset.easing ?? '').match(/cubic-bezier\(([^)]+)\)/);
      return m ? m[1].split(',').map((v) => Number(v.trim())) : [0, 0, 1, 1];
    };

    function renderChart(list: number[][]) {
      if (!chart) return;
      if (list.length === 0) {
        chart.innerHTML = '';
        return;
      }
      let minY = 0;
      let maxY = 100;
      const paths: string[] = [];

      list.forEach((bz, i) => {
        const [x1, y1, x2, y2] = bz;
        const cx1 = x1 * 100;
        const cy1 = (1 - y1) * 100;
        const cx2 = x2 * 100;
        const cy2 = (1 - y2) * 100;
        minY = Math.min(minY, cy1, cy2);
        maxY = Math.max(maxY, cy1, cy2);
        paths.push(
          `<path d="M 0 100 C ${cx1} ${cy1}, ${cx2} ${cy2}, 100 0" fill="none" stroke="var(--lab-curve-${i === 0 ? 'a' : 'b'})" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>`,
        );
      });

      const pad = 8;
      chart.setAttribute('viewBox', `${-pad} ${minY - pad} ${100 + pad * 2} ${maxY - minY + pad * 2}`);
      chart.innerHTML =
        `<line x1="0" y1="100" x2="100" y2="0" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"/>` +
        paths.join('');
    }

    function render() {
      cards.forEach((card) => {
        const idx = picked.indexOf(card);
        const state = idx === 0 ? 'a' : idx === 1 ? 'b' : '';
        card.dataset.pickState = state;
        const btn = card.querySelector<HTMLButtonElement>('[data-pick]');
        if (btn) {
          btn.setAttribute('aria-pressed', String(Boolean(state)));
          btn.textContent = state ? `已选 ${state.toUpperCase()}` : '对照';
        }
      });

      (['a', 'b'] as const).forEach((k, i) => {
        const slot = slotOf(k);
        if (!slot) return;
        const card = picked[i];
        const name = slot.querySelector<HTMLElement>('[data-slot-name]');
        const code = slot.querySelector<HTMLElement>('[data-slot-bezier]');
        if (name) name.textContent = card ? (card.querySelector('h3')?.textContent ?? '') : '未选';
        if (code) code.textContent = card ? (card.dataset.easing ?? '') : '';
      });

      renderChart(picked.map(bezierOf));

      const box = panel!.querySelector<HTMLElement>('[data-chart-box]');
      if (box) box.dataset.empty = String(picked.length === 0);

      if (controls) controls.hidden = picked.length < 2;
      if (hint) {
        hint.textContent =
          picked.length === 0
            ? '在下方任意卡片上点「对照」，选满两条即可开跑。'
            : picked.length === 1
              ? '再选一条就能开跑。'
              : '同帧播放：两条同时起跑、同时结束，差别只在过程。';
      }
    }

    function play() {
      if (picked.length < 2) return;
      const duration = Number(panel!.dataset.duration ?? 320);
      const dots = [dotOf('a'), dotOf('b')].filter((d): d is HTMLElement => Boolean(d));
      if (dots.length < 2) return;
      const eases = picked.map((c) => c.dataset.easing ?? 'linear');

      // 先归零，并强制回流，否则过渡会从上一次的终点开始
      dots.forEach((d) => {
        d.style.transition = 'none';
        d.style.transform = 'translateX(0px)';
      });
      void panel!.offsetWidth;

      // 同一个任务内写入两条过渡 —— 保证同一帧起跑
      dots.forEach((d, i) => {
        const track = d.closest<HTMLElement>('[data-track]');
        const dist = Math.max(0, (track?.clientWidth ?? 0) - 16 - d.offsetWidth);
        d.style.transition = `transform ${duration}ms ${eases[i]}`;
        d.style.transform = `translateX(${dist}px)`;
      });
    }

    cards.forEach((card) => {
      card.querySelector<HTMLButtonElement>('[data-pick]')?.addEventListener('click', () => {
        const before = picked.length;
        const i = picked.indexOf(card);
        if (i >= 0) picked.splice(i, 1);
        else {
          if (picked.length >= 2) picked.shift();
          picked.push(card);
        }
        render();
        if (picked.length === 2 && before < 2) {
          const reduce = document.documentElement.getAttribute('data-motion') === 'reduce';
          panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        }
      });
    });

    panel.querySelector('[data-compare-play]')?.addEventListener('click', play);

    panel.querySelector('[data-compare-clear]')?.addEventListener('click', () => {
      picked.length = 0;
      render();
    });

    panel.querySelectorAll<HTMLButtonElement>('.compare-dur').forEach((btn) => {
      btn.addEventListener('click', () => {
        panel.querySelectorAll<HTMLButtonElement>('.compare-dur').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        panel.dataset.duration = btn.dataset.dur ?? '320';
      });
    });

    render();
  }
</script>
